{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "env": {
    "NEXT_PUBLIC_API_KEY": "@next_public_api_key"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_BASE_URL": "http://localhost:5000/api/v1"
  },
  "functions": {
    "src/app/**/*.tsx": {
      "maxDuration": 30
    }
  }
}